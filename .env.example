# Variaveis de ambiente - Supabase (obrigatorias para o app funcionar)
# Copie este arquivo para .env.local e preencha com as chaves reais do seu projeto:
#   Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...sua-anon-key-aqui

# ATENCAO: Em producao (Vercel/Netlify), configure estas MESMAS variaveis no painel
# do host (Settings -> Environment Variables) e refaca o deploy.
# Sem elas, o app nao consegue falar com o Supabase e o login falha com "Failed to fetch".
